# Copy to .env in this directory. Real credentials must never be committed.
OPENROUTER_API_KEY=
RECHTSGRAPH_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
RECHTSGRAPH_EMBEDDING_DIMENSIONS=1024
# Optional model-specific query instruction; Qwen receives a default instruction.
# RECHTSGRAPH_EMBEDDING_QUERY_INSTRUCTION=
RECHTSGRAPH_SEARCH_MODE=hybrid
RECHTSGRAPH_NEO4J_URL=http://localhost:7474
RECHTSGRAPH_NEO4J_DATABASE=gii-xml-chunked
# Set existing credentials only when your Neo4j installation requires them.
# RECHTSGRAPH_NEO4J_USERNAME=neo4j
# RECHTSGRAPH_NEO4J_PASSWORD=
